{
    "compilerOptions":  {
                            "target":  "ES2022",
                            "lib":  [
                                        "DOM",
                                        "DOM.Iterable",
                                        "ES2022"
                                    ],
                            "strict":  true,
                            "module":  "ESNext",
                            "moduleResolution":  "Bundler",
                            "jsx":  "react-jsx",
                            "types":  [
                                          "chrome",
                                          "vitest/globals"
                                      ],
                            "skipLibCheck":  true,
                            "noEmit":  true,
                            "esModuleInterop":  true,
                            "allowSyntheticDefaultImports":  true,
                            "resolveJsonModule":  true,
                            "isolatedModules":  true
                        },
    "include":  [
                    "src",
                    "tests",
                    "vite.config.ts",
                    "vitest.config.ts"
                ]
}
